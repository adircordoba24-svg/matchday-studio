rules_version = '2';

// MATCHDAY STUDIO - חוקי אבטחה ל-Firestore
// לקוחות: יכולים רק ליצור הזמנה חדשה (ורק עם נתונים תקינים). אין להם גישת קריאה בכלל.
// מנהל:   רק החשבון המאומת למטה יכול לקרוא, לעדכן סטטוס ולמחוק.
// משנים את המייל אם צריך, ומדביקים את הקובץ בלשונית Rules ב-Firestore ולוחצים Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'adir.cordoba24@gmail.com';
    }

    function validOrder(d) {
      return d.keys().toSet() == [
          'player', 'number', 'contact', 'team', 'opponent', 'competition',
          'competitionLabel', 'venue', 'time', 'date', 'broadcast',
          'broadcastChannel', 'photoLayout', 'styleId', 'styleName',
          'photoCount', 'notes', 'rights', 'terms', 'ageOk', 'plan', 'status', 'createdAt'
        ].toSet()
        && d.player is string && d.player.size() >= 1 && d.player.size() <= 100
        && d.number is string && d.number.matches('^[0-9]{0,3}$')
        && d.contact is string && d.contact.matches('^05[0-9]{8}$')
        && d.team is string && d.team.size() >= 1 && d.team.size() <= 100
        && d.opponent is string && d.opponent.size() >= 1 && d.opponent.size() <= 100
        && d.competition in ['leumit', 'premier', 'state-cup']
        && d.competitionLabel is string && d.competitionLabel.size() <= 40
        && d.venue is string && d.venue.size() >= 1 && d.venue.size() <= 100
        && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.date is string && d.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.broadcast in ['yes', 'no']
        && d.broadcastChannel is string && d.broadcastChannel.size() <= 60
        && (d.broadcast != 'yes' || d.broadcastChannel.size() >= 1)
        && d.photoLayout in ['designer', 'single', 'double', 'triple']
        && d.styleId in ['md01', 'md02', 'md03', 'md04', 'md05', 'md06']
        && d.styleName is string && d.styleName.size() >= 1 && d.styleName.size() <= 60
        && d.photoCount is int && d.photoCount >= 1 && d.photoCount <= 3
        && d.notes is string && d.notes.size() <= 2000
        && d.rights == true
        && d.terms == true
        && d.ageOk == true
        && d.plan in ['single', 'subscription']
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow read, delete: if isAdmin();
      allow create: if validOrder(request.resource.data);
      // המנהל יכול לשנות רק את הסטטוס
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'progress', 'done', 'cancelled'];

      match /photos/{photoId} {
        allow read, delete: if isAdmin();
        // תמונה נוצרת רק באותה שליחה (batch) שיוצרת את ההזמנה, ורק עד מספר התמונות שהוגדר בה
        allow create: if photoId in ['0', '1', '2']
          && request.resource.data.keys().toSet() == ['data', 'type', 'width', 'height', 'name'].toSet()
          && request.resource.data.data is string
          && request.resource.data.data.size() >= 1000
          && request.resource.data.data.size() <= 950000
          && request.resource.data.type == 'image/jpeg'
          && request.resource.data.width is int
          && request.resource.data.height is int
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && int(photoId) < getAfter(/databases/$(database)/documents/orders/$(orderId)).data.photoCount;
      }
    }
  }
}
